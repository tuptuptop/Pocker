# Pocker Studio Environment Configuration
# Copy this file to .env and customize

# Pocker Engine API URL (the Rust backend)
POCKER_API_URL=http://127.0.0.1:3080

# Optional: Path to the Pocker engine binary (for auto-start)
# POCKER_ENGINE_PATH=../target/debug/pocker

# Server port
PORT=3000

# Server host
HOST=0.0.0.0

# LLM API Keys (used by plugins running in the engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Ollama (local LLM)
OLLAMA_HOST=http://127.0.0.1:11434
