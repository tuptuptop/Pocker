{
  "name": "pocker-studio",
  "version": "0.1.0",
  "description": "Pocker Studio — Plugin as a Service Web GUI. Chat, plugins, skills, terminal, and multi-agent orchestration powered by the Pocker engine.",
  "author": "Pocker Contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=2048\" vite dev --port 3000",
    "build": "vite build",
    "start": "NODE_OPTIONS=\"--max-old-space-size=2048\" node server-entry.js",
    "deploy": "npm run build && pkill -f 'node server-entry.js' 2>/dev/null; sleep 1; NODE_OPTIONS=\"--max-old-space-size=2048\" node server-entry.js",
    "start:dev": "NODE_OPTIONS=\"--max-old-space-size=2048\" vite dev --port 3000",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "electron:dev": "electron . --dev",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@lobehub/icons": "^5.0.1",
    "@lobehub/icons-static-png": "^1.83.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/react-grid-layout": "^1.3.6",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.10.1",
    "marked": "^17.0.1",
    "motion": "^12.29.2",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^2.9.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.0",
    "katex": "^0.18.0",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^6.0.2",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "eslint": "^10.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  },
  "keywords": [
    "pocker",
    "pocker-studio",
    "plugin-as-a-service",
    "ai-agent",
    "web-ui",
    "dashboard",
    "multi-agent",
    "llm",
    "self-hosted",
    "react",
    "typescript",
    "pwa",
    "ollama"
  ],
  "bugs": {
    "url": "https://github.com/samcaicn/gloai/issues"
  },
  "homepage": "https://github.com/samcaicn/gloai",
  "repository": {
    "type": "git",
    "url": "https://github.com/samcaicn/gloai.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "unrs-resolver"]
  },
  "build": {
    "appId": "com.pocker.studio",
    "productName": "PockerStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server-entry.js",
      "electron-main.js",
      "electron-preload.js",
      "package.json",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/favicon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "public/favicon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "public/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PockerStudio-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "PockerStudio-Setup-${version}.${ext}"
    }
  }
}
